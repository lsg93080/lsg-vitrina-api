# Server
PORT=3020
NODE_ENV=development
# CORS — comma-separated list of allowed origins
# Example: http://localhost:3007,https://lifesyncgames.interaction-lab.info
CORS_ORIGINS=http://localhost:3007

# MongoDB
MONGODB_URI=mongodb://localhost:27017/vitrina

# JWT (must match Auth Service JWT_SECRET exactly)
JWT_SECRET=your_jwt_secret_here

# Service-to-service
# AUTH_SERVICE_URL: full base URL including version prefix. Code appends only relative paths.
# Local:  http://localhost:3000/api/v1
# Nginx:  http://localhost/auth/api/v1
VITRINA_API_KEY=your_vitrina_api_key_here
AUTH_SERVICE_URL=http://localhost:3000/api/v1
AUTH_SERVICE_API_KEY=your_auth_service_api_key_here

# GitLab repo ownership verification (Sprint 6)
REQUIRE_REPO_OWNERSHIP_CHECK=false

# Mail: Resend (https://resend.com)
# Get the API key at resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=LifeSync-Games <noreply@lifesyncgames.com>

# Moderation
# Base URL of the Vitrina frontend (no trailing slash)
VITRINA_BASE_URL=http://localhost:3007/vitrina
MODERATION_AUTO_SUSPEND=false
MODERATION_UNSAFE_THRESHOLD=0.5
MODERATION_REVIEWERS_PER_PUB=5